class Solution{
    public:
        vector<int> primeTillN(int n){
            //your code goes here
            vector<bool> isPrime(n+1,true);
            vector<int>ans;
            isPrime[0] = isPrime[1] = false;

            for(int p = 2;p*p<n;p++){
                if(isPrime[p]){
                    for(int i = p*p;i<n;i += p){
                        isPrime[i] = false;
                    }
                }
            }
            for(int i=2;i<=n;i++){
                if(isPrime[i] == true){
                    ans.push_back(i);
                }
            }
            return ans;
        }
};
